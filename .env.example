# PBRMS Environment Configuration
# Copy this file to .env and configure your local settings

# Application
FLASK_ENV=development
FLASK_APP=backend/app.py
SECRET_KEY=pbrms-super-secret-key-change-in-production-2026
JWT_EXPIRY_HOURS=24
PORT=5000

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pbrms_db

